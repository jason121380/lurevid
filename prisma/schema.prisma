generator client {
  provider      = "prisma-client-js"
  // 部署 runtime（Debian bookworm / OpenSSL 3.0）需要 debian-openssl-3.0.x engine；
  // native 供本機開發使用。
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  QUEUED
  ANALYZING
  ANALYSIS_READY
  STRUCTURING
  STRUCTURE_READY
  ADAPTING
  ADAPT_READY
  STORYBOARDING
  STORYBOARD_READY
  GENERATING
  MERGING
  COMPLETED
  FAILED
}

enum SceneStatus {
  DRAFT
  PROMPT_READY
  IMAGE_GENERATING
  IMAGE_READY
  QUEUED
  GENERATING
  SUCCEEDED
  FAILED
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String?
  passwordHash String
  projects     Project[]
  resetTokens  PasswordResetToken[]
  generations  Generation[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

/// 忘記密碼用的一次性重設票證。只存 token 的 SHA-256 雜湊，
/// 資料庫外洩時無法反推出可用的重設連結。
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id                 String        @id @default(cuid())
  userId             String?
  user               User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String        @default("未命名專案")
  idea               String        @default("")
  sourceUrl          String?
  sourcePlatform     String?
  sourceVideoUrl     String?
  sourceFrameUrls    Json?
  steps              Json          @default("{}")
  sourceTranscript   String?       @db.Text
  visualAnalysis     String?       @db.Text
  analysis           String?       @db.Text
  structure          String?       @db.Text
  adaptedScript      String?       @db.Text
  status             ProjectStatus @default(DRAFT)
  message            String        @default("等待開始")
  progress           Float         @default(0)
  ratio              String        @default("9:16")
  resolution         String        @default("720p")
  duration           Int           @default(8)
  storyboardImageUrl String?
  finalVideoUrl      String?
  error              String?
  scenes             Scene[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId])
}

model Scene {
  id             String      @id @default(cuid())
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneNumber    Int
  title          String
  visualGoal     String
  imagePrompt    String?     @db.Text
  imageUrl       String?
  imageLocalPath String?
  seedancePrompt String      @db.Text
  status         SceneStatus @default(DRAFT)
  seedanceTaskId String?
  videoUrl       String?
  localPath      String?
  error          String?
  raw            Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([projectId, sceneNumber])
}

enum GenerationKind {
  IMAGE
  VIDEO
}

enum GenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// 「快速使用」的單次文生圖／文生影片。與 Project 的八步流程無關，
/// 每張卡片就是一筆，因此要能跨重新整理存活。
model Generation {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      GenerationKind
  prompt    String           @db.Text
  status    GenerationStatus @default(QUEUED)
  ratio     String           @default("9:16")
  duration  Int              @default(8)
  model     String           @default("")
  resultUrl String?
  taskId    String?
  error     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, kind, createdAt])
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
